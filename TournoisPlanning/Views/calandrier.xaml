<UserControl x:Class="TournoisPlanning.Views.calandrier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TournoisPlanning.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Styles pour les boutons -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F3F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les cellules du calendrier -->
        <Style x:Key="CalendarCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="120"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les matchs -->
        <Style x:Key="MatchStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Template pour les jours de la semaine -->
        <DataTemplate x:Key="DayHeaderTemplate">
            <TextBlock Text="{Binding}" 
                       FontWeight="SemiBold" 
                       FontSize="12"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- Template pour les cellules du calendrier -->
        <DataTemplate x:Key="CalendarCellTemplate">
            <Border Style="{StaticResource CalendarCellStyle}">
                <Border.Background>
                    <SolidColorBrush Color="{Binding BackgroundColor}"/>
                </Border.Background>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête avec numéro du jour -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Numéro du jour -->
                        <Border Grid.Column="0" 
                                CornerRadius="12" 
                                Padding="6,2"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding DateBackgroundColor}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding Day}" 
                                       FontSize="12" 
                                       FontWeight="Medium"
                                       Foreground="{Binding DateForeground}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Indicateur de matchs -->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="🏆" FontSize="10" Margin="0,0,2,0"/>
                            <TextBlock Text="{Binding MatchCount}" 
                                       FontSize="10" 
                                       FontWeight="Medium"
                                       Foreground="#8B5CF6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Liste des matchs -->
                    <ItemsControl Grid.Row="1" 
                                  ItemsSource="{Binding Matches}" 
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MatchStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="10"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} vs {1}">
                                                    <Binding Path="Equipe1.Nom"/>
                                                    <Binding Path="Equipe2.Nom"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="🕐" FontSize="8" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Date}" 
                                                       FontSize="8"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="White" 
                BorderBrush="#E5E7EB" 
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Calendrier" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#111827"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="PrevMonthButton" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="PrevMonthButton_Click">
                            <TextBlock Text="‹" FontSize="20" Foreground="#6B7280"/>
                        </Button>

                        <TextBlock Name="CurrentMonthText" 
                                   Text="{Binding CurrentMonthYear}"
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   MinWidth="200"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>

                        <Button Name="NextMonthButton" 
                                Style="{StaticResource NavButtonStyle}"
                                Click="NextMonthButton_Click">
                            <TextBlock Text="›" FontSize="20" Foreground="#6B7280"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Name="CreateMatchButton"
                        Style="{StaticResource CreateButtonStyle}"
                        Click="CreateMatchButton_Click">
                    <TextBlock Text="Nouveau Match"/>
                </Button>
            </Grid>
        </Border>

        <!-- En-têtes des jours -->
        <Border Grid.Row="1" 
               Background="#F9FAFB" 
               BorderBrush="#E5E7EB" 
               BorderThickness="0,0,0,1">
           <UniformGrid Rows="1" Columns="7" Height="48">
               <TextBlock Text="Dim" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
               <TextBlock Text="Lun" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
               <TextBlock Text="Mar" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
               <TextBlock Text="Mer" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
               <TextBlock Text="Jeu" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
               <TextBlock Text="Ven" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
               <TextBlock Text="Sam" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          FontWeight="SemiBold" 
                          FontSize="12" 
                          Foreground="#6B7280"/>
           </UniformGrid>
        </Border>

        <!-- Grille du calendrier -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="12" 
                    Margin="24">
                <Border.Effect>
                    <DropShadowEffect Color="LightGray" 
                                      BlurRadius="16" 
                                      ShadowDepth="4" 
                                      Direction="270"/>
                </Border.Effect>

                <ItemsControl Name="CalendarGrid" 
                              ItemsSource="{Binding CalendarDays}"
                              ItemTemplate="{StaticResource CalendarCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- Légende -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="12" 
                Margin="24,0,24,24"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="LightGray" 
                                  BlurRadius="16" 
                                  ShadowDepth="4" 
                                  Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Légende des Tournois" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="#111827"
                           Margin="0,0,0,16"/>

                <ItemsControl Name="TournamentLegend" 
                              ItemsSource="{Binding TournamentTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color}" 
                                    CornerRadius="8" 
                                    Padding="12,6" 
                                    Margin="0,0,12,8">
                                <TextBlock Text="{Binding tournoi.Nom}" 
                                           FontSize="12" 
                                           FontWeight="Medium"
                                           Foreground="{Binding TextColor}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>